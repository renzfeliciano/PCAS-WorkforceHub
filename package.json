    "@upstash/redis": "^1.38.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "^1.40.0",
    "mongoose": "^9.9.4",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
